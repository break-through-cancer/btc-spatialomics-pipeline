// =============================================================================
// process-compute.config
// Cirro compute override for the H&E Spatial Heterogeneity pipeline.
// This file is injected by Cirro as an additional nextflow.config at runtime.
// =============================================================================

process {

    // Point every process at the ECR image.
    // Cirro's AWS Batch environment pulls from ECR automatically — no sudo needed.
    container     = 'ghcr.io/break-through-cancer/he-analysis:latest'

    // Default resource allocation for the single HE_ANALYSIS process.
    // The R script is CPU-bound (Monte Carlo loops) and loads all H5 files into
    // memory, so 4 vCPUs + 16 GB is appropriate for a modest cohort.
    cpus   = 4
    memory = '16 GB'
    time   = '2h'

    // Retry on AWS Batch OOM kill signals (exit codes 137-140).
    // Scale memory up with each attempt, cap at 3 retries.
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 3

    withName: HE_ANALYSIS {
        // Double memory on each retry attempt (16 GB → 32 GB → 64 GB).
        memory = { 16.GB * task.attempt }
        cpus   = 4
    }
}

docker.enabled = true
