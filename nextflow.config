// =============================================================================
// nextflow.config – H&E Spatial Heterogeneity Pipeline
// =============================================================================

nextflow.enable.dsl = 2

manifest {
    name            = 'btc-spatialomics-pipeline'
    description     = 'H&E tissue heterogeneity analysis (Monte Carlo + PCA + LME)'
    version         = '0.1.0'
    nextflowVersion = '>=23.0.0'
}

// -----------------------------------------------------------------------------
// Default parameters
// -----------------------------------------------------------------------------
params {
    input_dir  = null
    output_dir = "${launchDir}/results"
    help       = false

    container__he_analysis = 'ghcr.io/break-through-cancer/he-analysis:latest'
}

// -----------------------------------------------------------------------------
// Default process resource limits
// -----------------------------------------------------------------------------
process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries    = 2

    cpus   = 4
    memory = '48 GB'
    time   = '2h'
}

// -----------------------------------------------------------------------------
// Profiles
// -----------------------------------------------------------------------------
profiles {

    // ── Local VM with Docker ──────────────────────────────────────────────────
    vm_docker {
        docker.enabled    = true
        docker.sudo       = true
        docker.runOptions = '-v /mnt/disk1:/mnt/disk1'
        process.executor  = 'local'
    }

    // ── AWS Batch / Cirro ─────────────────────────────────────────────────────
    // Cirro injects the queue and region at runtime — leave unset here.
    aws_batch {
        process.executor  = 'awsbatch'
        // queue is managed by Cirro
        process.container = params.container__he_analysis
        docker.enabled    = true
    }

}
