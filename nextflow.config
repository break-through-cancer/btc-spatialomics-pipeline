// =============================================================================
// nextflow.config – H&E Spatial Heterogeneity Pipeline
// =============================================================================

manifest {
    name            = 'btc-spatialomics-pipeline'
    description     = 'H&E tissue heterogeneity analysis (Monte Carlo + PCA + LME)'
    version         = '0.1.0'
    nextflowVersion = '>=23.0.0'
}

// -----------------------------------------------------------------------------
// Default parameters
// -----------------------------------------------------------------------------
params {
    input_dir  = null
    output_dir = "${launchDir}/results"
    help       = false
}

// -----------------------------------------------------------------------------
// Default process resource limits
// -----------------------------------------------------------------------------
process {
    cpus   = 4
    memory = '48 GB'
    time   = '2h'
}

// -----------------------------------------------------------------------------
// Profiles
// -----------------------------------------------------------------------------
profiles {

    // ── Local VM with Docker ──────────────────────────────────────────────────
    // Use this profile for development and testing on the BTC VM.
    // Remove docker.sudo once spalreddy is in the docker group.
    vm_docker {
        docker.enabled    = true
        docker.sudo       = true
        docker.runOptions = '-v /mnt/disk1:/mnt/disk1'
        process.executor  = 'local'
    }

    // ── AWS Batch / Cirro ─────────────────────────────────────────────────────
    // To be populated once the image is pushed to ECR and Cirro queue is known.
    // ECR registry observed from neodisc pipeline: 590183655792.dkr.ecr.us-east-1.amazonaws.com
    aws_batch {
        process.executor  = 'awsbatch'
        process.queue     = 'FILL_IN_CIRRO_BATCH_QUEUE'
        process.container = '590183655792.dkr.ecr.us-east-1.amazonaws.com/pipelines/btc:he-analysis-latest'
        aws.region        = 'us-east-1'
        docker.enabled    = true
    }

}
